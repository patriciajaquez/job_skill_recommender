# ============================================================
# Job Skill Recommender — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# --- Job APIs ---

# Adzuna (https://developer.adzuna.com)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Reed (https://www.reed.co.uk/developers)
REED_API_KEY=your_reed_api_key_here

# RapidAPI (https://rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here

# Theirstack (https://theirstack.com)
THEIRSTACK_API_KEY=your_theirstack_api_key_here

# The Muse (https://www.themuse.com/developers/api/v2) — free tier, no key required
MUSE_API_KEY=optional_leave_blank_if_unused

# --- Coursera (optional) ---
COURSERA_APP_ID=your_coursera_app_id_here
COURSERA_CLIENT_ID=your_coursera_client_id_here
COURSERA_CLIENT_SECRET=your_coursera_client_secret_here

# --- Database (optional, defaults to local SQLite if not set) ---
DATABASE_URL=sqlite:///data/jobs.db

# --- Pipeline config ---
PIPELINE_SCHEDULE_HOURS=4
DATA_RETENTION_DAYS=30
